[Unit]
Description=BIZ_OS Performance Monitor Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/perf-monitor-service
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment="RUST_LOG=info"
Environment="BIZOS_PERF_MONITOR_BIND=127.0.0.1:8081"
Environment="BIZOS_PERF_MONITOR_POLL_MS=1000"
Environment="BIZOS_PERF_MONITOR_HISTORY_CAP=900"

# Security
User=bizos
Group=bizos

[Install]
WantedBy=multi-user.target
