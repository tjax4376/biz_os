# BIZ_OS Docker Ignore File
# Optimizes Docker build context

# Git
.git
.gitignore
.gitattributes

# Build artifacts
target/
*.o
*.ko
*.so
*.a
*.bin
*.img
*.iso
*.qcow2
*.vdi
*.vhd
*.raw

# Kernel build artifacts
kernel/linux/.config
kernel/linux/.config.old
kernel/linux/arch/*/boot/
kernel/linux/vmlinux
kernel/linux/System.map
kernel/linux/modules.builtin
kernel/linux/modules.order

# Rust
Cargo.lock
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node/React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# AI Models (large files - exclude from build context)
*.gguf
*.bin
*.safetensors
ai-runtime/models/
*.pt
*.pth
*.onnx

# Buildroot
buildroot/output/
buildroot/dl/

# VM images
*.vmdk

# Temporary files
*.tmp
*.bak
*.backup

# OS specific
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets
.env
.env.local
*.key
*.pem
*.cert

# Docker files (don't need to copy into container)
docker-compose.yml
Dockerfile
.dockerignore

# Documentation (not needed in container)
*.md
docs/

# Memory cards (not needed in container)
.memory/
