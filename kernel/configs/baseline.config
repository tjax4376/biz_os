# BIZ_OS Kernel Baseline Configuration
# Based on Linux kernel 6.x
# This is a minimal configuration for VM deployment

# Basic kernel features
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y

# Essential subsystems
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PCI=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Network
CONFIG_NET_CORE=y
CONFIG_NETWORK_FILESYSTEMS=y

# GPU support (for AI acceleration)
CONFIG_DRM=y
CONFIG_DRM_I915=y  # Intel
CONFIG_DRM_AMDGPU=y  # AMD
CONFIG_DRM_NOUVEAU=y  # NVIDIA (nouveau)

# AI-specific optimizations
CONFIG_AI_RUNTIME=y  # Kernel-level AI runtime
CONFIG_AI_RUNTIME_GPU=y  # GPU acceleration
CONFIG_AI_RUNTIME_CUDA=y  # NVIDIA CUDA support
CONFIG_AI_RUNTIME_OPENCL=y  # OpenCL support
CONFIG_AI_RUNTIME_UNIFIED_MEMORY=y  # Unified CPU/GPU memory
CONFIG_AI_RUNTIME_CACHE=y  # Result caching
CONFIG_AI_RUNTIME_SECURITY=y  # Security and access control
CONFIG_AI_RUNTIME_DEBUG=n  # Debug support (disable for production)
# CONFIG_AI_SCHEDULER=y  # Custom scheduler (future)

# Virtualization support
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# Debugging (for development)
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y

